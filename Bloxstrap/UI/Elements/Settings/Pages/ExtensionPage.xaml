<ui:UiPage
    x:Class="StarStrap.UI.Elements.Settings.Pages.ExtensionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StarStrap.UI.Elements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:StarStrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ExtensionPage"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Scrollable="True"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,14,14">
        <TextBlock
            FontSize="14"
            Margin="0,0,0,14"
            Foreground="{StaticResource TextFillColorSecondaryBrush}"
            Text="Manage external tools that run alongside Roblox." />

        <TextBlock
            Margin="0,8,0,0"
            FontSize="20"
            FontWeight="Medium"
            Text="Fleasion" />

        <controls:OptionControl 
            Header="Enable Fleasion"
            Description="Automatically launch Fleasion optimizer when Roblox starts.">
            <ui:ToggleSwitch IsChecked="{Binding FleasionEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock
            Margin="0,16,0,0"
            FontSize="20"
            FontWeight="Medium"
            Text="Memory Optimization" />

        <controls:OptionControl 
            Header="MemReduct"
            Description="Automatically clean Roblox memory every 5 minutes while playing. Downloads portable MemReduct on first enable.">
            <ui:ToggleSwitch IsChecked="{Binding MemReductEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock
            Margin="0,16,0,0"
            FontSize="20"
            FontWeight="Medium"
            Text="Windows Optimization" />

        <controls:OptionControl 
            Header="Remove Unimportant Windows"
            Description="Closes some unimportant instances of Windows (like bloatware) on Roblox launch to free up resources.">
            <ui:ToggleSwitch IsChecked="{Binding OptimizeWindowsEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Clear Temp Files"
            Description="Clears Windows and Roblox temporary files when launching Roblox.">
            <ui:ToggleSwitch IsChecked="{Binding ClearTempFilesEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="High CPU Priority"
            Description="Automatically sets the Roblox process priority to High for better frame rates.">
            <ui:ToggleSwitch IsChecked="{Binding HighCpuPriorityEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Cancel Xbox Gamebar"
            Description="Temporarily closes the Xbox Gamebar process while Roblox is running to improve performance.">
            <ui:ToggleSwitch IsChecked="{Binding CancelXboxGameBarEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="Close Background Apps"
            Description="Temporarily closes non-essential background applications (like Spotify, Discord) to free up memory.">
            <ui:ToggleSwitch IsChecked="{Binding CloseBackgroundAppsEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

    </StackPanel>
</ui:UiPage>
