<ui:UiPage
    x:Class="StarStrap.UI.Elements.Settings.Pages.AIAgentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StarStrap.UI.Elements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:StarStrap.UI.ViewModels.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AIAgentPage"
    d:DesignHeight="800"
    d:DesignWidth="800"
    Scrollable="True"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,14,14">
        <TextBlock
            FontSize="14"
            Margin="0,0,0,14"
            Foreground="{StaticResource TextFillColorSecondaryBrush}"
            Text="Configure your AI Co-pilot to take screenshots and give you advice while playing Roblox." />

        <controls:OptionControl
            Header="Enable AI Agent"
            Description="Turn on the AI Agent functionality to be active while Roblox is running.">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding AIAgentEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="AI Provider"
            Description="Select the AI service you want to use for generating advice."
            IsEnabled="{Binding AIAgentEnabled, Mode=OneWay}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding Providers}" SelectedItem="{Binding AIAgentProvider, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="API Key"
            Description="Your API key for the selected AI Provider."
            IsEnabled="{Binding AIAgentEnabled, Mode=OneWay}">
            <ui:TextBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" Text="{Binding AIAgentApiKey, Mode=TwoWay}" PlaceholderText="sk-..." />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Hotkey"
            Description="The hotkey to press in-game to trigger the AI Agent."
            IsEnabled="{Binding AIAgentEnabled, Mode=OneWay}">
            <ui:TextBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" Text="{Binding AIAgentHotkey, Mode=TwoWay}" PlaceholderText="Alt+A" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="System Prompt"
            Description="The instruction given to the AI about how it should behave."
            IsEnabled="{Binding AIAgentEnabled, Mode=OneWay}">
            <ui:TextBox Width="300" Margin="5,0,0,0" Padding="10,5,10,5" Text="{Binding AIAgentSystemPrompt, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />
        </controls:OptionControl>

    </StackPanel>
</ui:UiPage>
