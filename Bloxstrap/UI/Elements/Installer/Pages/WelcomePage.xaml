<ui:UiPage x:Class="StarStrap.UI.Elements.Installer.Pages.WelcomePage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:local="clr-namespace:StarStrap.UI.Elements.Installer.Pages"
           xmlns:models="clr-namespace:StarStrap.UI.ViewModels"
           xmlns:dmodels="clr-namespace:StarStrap.UI.ViewModels.Installer"
           xmlns:resources="clr-namespace:StarStrap.Resources"
           xmlns:controls="clr-namespace:StarStrap.UI.Elements.Controls"
           mc:Ignorable="d" 
           d:DataContext="{d:DesignInstance dmodels:WelcomeViewModel, IsDesignTimeCreatable=True}"
           d:DesignHeight="450" d:DesignWidth="800"
           Title="WelcomePage"
           Scrollable="True"
           Loaded="UiPage_Loaded">

    <StackPanel>

        <controls:MarkdownTextBlock FontSize="14" MarkdownText="{Binding MainText, Mode=OneWay}" TextWrapping="Wrap" />

        <TextBlock Margin="0,24,0,0" FontSize="14" Text="{x:Static resources:Strings.Installer_Welcome_NextToContinue}" TextWrapping="Wrap" Visibility="{Binding CanContinue, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock FontSize="14" TextWrapping="Wrap">
            Welcome to StarStrap! Maybe theres hope?
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <ui:Button Content="Donate"
                       Icon="Heart24"
                       Margin="0,0,8,0"
                       Click="DonateButton_Click" />
        </StackPanel>
    </StackPanel>
</ui:UiPage>
