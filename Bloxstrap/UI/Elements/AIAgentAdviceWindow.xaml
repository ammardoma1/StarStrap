<ui:UiWindow
    x:Class="StarStrap.UI.Elements.AIAgentAdviceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AI Agent Advice"
    Width="400"
    Height="300"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AI Co-Pilot Advice" Icon="Bot24" />

        <Border Grid.Row="1" Margin="10" Padding="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="AdviceTextBlock" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ScrollViewer>
        </Border>
    </Grid>
</ui:UiWindow>
